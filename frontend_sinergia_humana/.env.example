# Cuando es true, todos los servicios usan datos mock en memoria.
# Cuando se cambie a false, los servicios usarán apiClient (Axios) contra Django.
VITE_USE_MOCKS=true

# Base URL de la API Django REST Framework (se usará cuando VITE_USE_MOCKS=false)
VITE_API_BASE_URL=http://localhost:8000/api

# Delay artificial (ms) para simular latencia de red en los mocks
VITE_MOCK_DELAY_MS=600
